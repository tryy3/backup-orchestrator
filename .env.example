# Local development environment — copy to `.env` and adjust.
#   cp .env.example .env
#
# `.env` is git-ignored. `just` and direnv load it as-is (no rewriting).
# Use absolute paths for BACKUP_DB_PATH / BACKUP_DATA_DIR so they work when
# recipes `cd` into server/ or agent/.

# ── Server ────────────────────────────────────────────────────────────────────
BACKUP_HTTP_PORT=8080
BACKUP_GRPC_PORT=8443

# Local SQLite file for `sqlite` / `turso-sync` (absolute path recommended).
BACKUP_DB_PATH=/absolute/path/to/backup-orchestrator/tmp/server.db

# Database backend: sqlite (default) | turso | turso-sync
# BACKUP_DB_DRIVER=sqlite

# Turso (required when BACKUP_DB_DRIVER is turso or turso-sync).
# Create a Turso Database with: turso db create <name> --tursodb
# BACKUP_DB_DRIVER=turso
# BACKUP_DB_URL=
# BACKUP_DB_AUTH_TOKEN=
# BACKUP_ENCRYPTION_KEY=

# Turso Sync — local file is primary; cloud is a replica.
# Plain modernc SQLite files cannot be pointed at turso-sync directly (CDC).
# Cutover: just migrate-turso-sync <old.db> <new-empty.db>
# (imports to remote, then Pull-bootstraps local — do not reuse corrupt sync files)
# See docs/turso-server-database.md.
# BACKUP_DB_DRIVER=turso-sync
# BACKUP_DB_URL=
# BACKUP_DB_AUTH_TOKEN=
# BACKUP_DB_SYNC_INTERVAL=30s
# BACKUP_ENCRYPTION_KEY=

# CORS (comma-separated). Defaults cover Vite dev ports if unset.
# BACKUP_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Agent ─────────────────────────────────────────────────────────────────────
BACKUP_SERVER_URL=localhost:8443
BACKUP_AGENT_NAME=dev-agent
BACKUP_DATA_DIR=/absolute/path/to/backup-orchestrator/tmp/agent-data
